# --- dependencies -----------------------------------------------------------
# node_modules/ holds the dev-only symlink/junction created by
# setup-dev-links.ps1 or tools/fetch-dev-deps.mjs. The plugin itself has zero
# runtime dependencies and never ships them.
node_modules/

# .dev-deps/package.json pins the DSH runtime versions the offline suite needs,
# so it IS tracked; only the installed tree and npm's scratch files are not.
.dev-deps/node_modules/
.dev-deps/package-lock.json
.dev-deps/.package-lock.json

# --- logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- secrets / local credentials -------------------------------------------
# Never commit API keys. Configure them through the settings page
# ($DSH_HOME/.credentials.yaml) or environment variables instead.
.env
.env.*
!.env.example
.credentials.yaml
credentials.yaml

# --- local runtime state ----------------------------------------------------
.dsh-literature-search/
diagnostics.json

# --- build / test scratch ---------------------------------------------------
.tmp/
tmp/
*.tmp
dist/
coverage/
.nyc_output/

# --- editors ----------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.swn
*~

# --- operating systems ------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
